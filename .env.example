# Amazon Kindle Credentials
# Note: These are used to access your Kindle highlights via Amazon's API
# Your credentials are stored locally and never shared

AMAZON_EMAIL=your-email@example.com
AMAZON_PASSWORD=your-password-here

# Optional: Kindle device serial number or name
# If you have multiple Kindle devices, specify which one to sync from
KINDLE_DEVICE_ID=

# Optional: Amazon marketplace (default: US)
# Options: US, UK, DE, FR, ES, IT, JP, CA, etc.
AMAZON_MARKETPLACE=US
